{
	"appId": "com.andrewcardon.wellnessquest",
	"appName": "Wellness Quest",
	"webDir": "www",
	"ios": {
		"contentInset": "always",
		"scrollEnabled": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#0a0a12",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "dark",
			"backgroundColor": "#0a0a12"
		},
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		},
		"CapacitorSQLite": {
			"iosDatabaseLocation": "Library/CapacitorDatabase"
		}
	},
	"packageClassList": [
		"CapacitorSQLitePlugin",
		"AppPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
